{
  "name": "forge-engineering-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "artifacts:generate": "node scripts/generate_public_artifacts.mjs",
    "audit:summary:local": "node scripts/audit_summary.mjs --local",
    "audit:summary:remote": "node scripts/audit_summary.mjs --remote",
    "build": "npm run artifacts:generate && node scripts/build_static_site.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ask-forge-demo --local",
    "dev": "npm run build && wrangler pages dev",
    "test": "node --test tests/*.test.js",
    "test:live": "python3 scripts/test_bailian_api.py"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
